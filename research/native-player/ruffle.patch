+//! Vector extraction used by Graphics.readGraphicsData. Snapshot the paths before
+//! constructing AVM objects, so no drawing borrow crosses an AVM call.
+use crate::avm2::globals::flash::geom::transform::matrix_to_object;
+use crate::avm2::object::{ArrayObject, BitmapDataObject, VectorObject};
+use crate::avm2::vector::VectorStorage;
+use crate::avm2::{Activation, ArrayStorage, Error, Value};
+use crate::bitmap::bitmap_data::BitmapData;
+use crate::character::Character;
+use crate::display_object::{DisplayObject, TDisplayObject};
+use crate::prelude::TDisplayObjectContainer;
+use crate::string::AvmString;
+use ruffle_render::bitmap::{BitmapInfo, PixelRegion, PixelSnapping};
+use ruffle_render::commands::{CommandHandler, CommandList};
+use ruffle_render::matrix::Matrix;
+use ruffle_render::quality::StageQuality;
+use ruffle_render::shape_utils::{DrawCommand, DrawPath, FillRule};
+use ruffle_render::transform::Transform;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use swf::{Color, ColorTransform, FillStyle, GradientInterpolation, GradientSpread, Point, Twips};
+
+fn extracted_color(color: Color, transform: ColorTransform) -> Color {
+    let mut color = &transform * color;
+    if color.a > 0 && color.a < 255 {
+        let alpha = color.a as f64;
+        let channel = |v: u8| ((v as f64 * alpha / 255.0).round() * 255.0 / alpha).round() as u8;
+        color.r = channel(color.r);
+        color.g = channel(color.g);
+        color.b = channel(color.b);
+    }
+    color
+}
+
+fn construct<'gc>(
+    a: &mut Activation<'_, 'gc>,
+    name: &'static str,
+    args: &[Value<'gc>],
+) -> Result<Value<'gc>, Error<'gc>> {
+    let name = AvmString::new_utf8(a.gc(), name);
+    let domain = a.avm2().playerglobals_domain();
+    let class = domain
+        .get_defined_value_handling_vector(a, name)?
+        .as_object()
+        .unwrap()
+        .as_class_object()
+        .unwrap();
+    class.construct(a, args)
+}
+fn string<'gc>(a: &mut Activation<'_, 'gc>, value: &'static str) -> Value<'gc> {
+    AvmString::new_utf8(a.gc(), value).into()
+}
+fn array<'gc>(a: &mut Activation<'_, 'gc>, values: Vec<Value<'gc>>) -> Value<'gc> {
+    ArrayObject::from_storage(a.context, ArrayStorage::from_iter(values)).into()
+}
+
+fn bitmap<'gc>(
+    a: &mut Activation<'_, 'gc>,
+    owner: DisplayObject<'gc>,
+    id: u16,
+    info: Option<BitmapInfo>,
+) -> Option<Value<'gc>> {
+    let data = if let Some(info) = info {
+        let data = BitmapData::new(a.gc(), info.width, info.height, true, 0);
+        let target = data.bitmap_handle(a.gc(), a.context.renderer);
+        let region = PixelRegion::for_whole_size(info.width, info.height);
+        let mut commands = CommandList::new();
+        commands.render_bitmap(
+            info.handle,
+            Transform::default(),
+            false,
+            PixelSnapping::Never,
+            region,
+        );
+        let sync =
+            a.context
+                .renderer
+                .render_offscreen(target, commands, StageQuality::High, region)?;
+        let (raw, _) = data.overwrite_cpu_pixels_from_gpu(a.gc());
+        raw.borrow_mut(a.gc()).set_gpu_dirty(a.gc(), sync, region);
+        data
+    } else {
+        let movie = owner.movie();
+        let character = a
+            .context
+            .library
+            .library_for_movie(movie)
+            .and_then(|lib| lib.character_by_id(id));
+        let Character::Bitmap(source) = character? else {
+            return None;
+        };
+        let decoded = source.compressed().decode().ok()?;
+        BitmapData::new_with_pixels(
+            a.gc(),
+            decoded.width(),
+            decoded.height(),
+            true,
+            decoded
+                .as_colors()
+                .map(crate::bitmap::bitmap_data::Color::from)
+                .collect(),
+        )
+    };
+    Some(BitmapDataObject::from_bitmap_data(a.context, data).into())
+}
+
+fn fill<'gc>(
+    a: &mut Activation<'_, 'gc>,
+    owner: DisplayObject<'gc>,
+    style: &FillStyle,
+    matrix: Matrix,
+    color_transform: ColorTransform,
+    bitmaps: &[BitmapInfo],
+) -> Result<Option<Value<'gc>>, Error<'gc>> {
+    match style {
+        FillStyle::Color(color) => {
+            let color = extracted_color(*color, color_transform);
+            construct(
+                a,
+                "flash.display::GraphicsSolidFill",
+                &[color.to_rgb().into(), (color.a as f64 / 255.0).into()],
+            )
+            .map(Some)
+        }
+        FillStyle::Bitmap {
+            id,
+            matrix: bitmap_matrix,
+            ..
+        } => {
+            let Some(data) = bitmap(a, owner, *id, bitmaps.get(*id as usize).cloned()) else {
+                return Ok(None);
+            };
+            let mut bm = Matrix::from(*bitmap_matrix);
+            bm.a /= 20.0;
+            bm.b /= 20.0;
+            bm.c /= 20.0;
+            bm.d /= 20.0;
+            let bm = matrix_to_object(matrix * bm, a)?;
+            construct(
+                a,
+                "flash.display::GraphicsBitmapFill",
+                &[data, bm, true.into(), false.into()],
+            )
+            .map(Some)
+        }
+        FillStyle::LinearGradient(g)
+        | FillStyle::RadialGradient(g)
+        | FillStyle::FocalGradient { gradient: g, .. } => {
+            let kind = string(
+                a,
+                if matches!(style, FillStyle::LinearGradient(_)) {
+                    "linear"
+                } else {
+                    "radial"
+                },
+            );
+            let colors = array(
+                a,
+                g.records
+                    .iter()
+                    .map(|v| Value::from(extracted_color(v.color, color_transform).to_rgba()))
+                    .collect(),
+            );
+            let alphas = array(
+                a,
+                g.records
+                    .iter()
+                    .map(|v| {
+                        Value::from(extracted_color(v.color, color_transform).a as f64 / 255.0)
+                    })
+                    .collect(),
+            );
+            let ratios = array(
+                a,
+                g.records
+                    .iter()
+                    .map(|v| Value::from(v.ratio as u32))
+                    .collect(),
+            );
+            let bm = matrix_to_object(matrix * Matrix::from(g.matrix), a)?;
+            let spread = string(
+                a,
+                match g.spread {
+                    GradientSpread::Pad => "pad",
+                    GradientSpread::Reflect => "reflect",
+                    GradientSpread::Repeat => "repeat",
+                },
+            );
+            let interpolation = string(
+                a,
+                match g.interpolation {
+                    GradientInterpolation::Rgb => "rgb",
+                    GradientInterpolation::LinearRgb => "linearRGB",
+                },
+            );
+            let focal = if let FillStyle::FocalGradient { focal_point, .. } = style {
+                focal_point.to_f64()
+            } else {
+                0.0
+            };
+            construct(
+                a,
+                "flash.display::GraphicsGradientFill",
+                &[
+                    kind,
+                    colors,
+                    alphas,
+                    ratios,
+                    bm,
+                    spread,
+                    interpolation,
+                    focal.into(),
+                ],
+            )
+            .map(Some)
+        }
+    }
+}
+
+fn path<'gc>(
+    a: &mut Activation<'_, 'gc>,
+    commands: Vec<DrawCommand>,
+    matrix: Matrix,
+    winding: FillRule,
+    close: bool,
+) -> Result<Option<Value<'gc>>, Error<'gc>> {
+    let mut output = Vec::new();
+    let mut data = Vec::new();
+    let mut cursor = Point::ZERO;
+    let mut start = Point::ZERO;
+    let mut pending_move = Some(Point::ZERO);
+    let mut drawn = false;
+    fn point<'gc>(data: &mut Vec<Value<'gc>>, matrix: Matrix, p: Point<Twips>) {
+        let p = matrix * p;
+        data.push(p.x.to_pixels().into());
+        data.push(p.y.to_pixels().into());
+    }
+    for command in commands {
+        if let DrawCommand::MoveTo(p) = command {
+            if close && drawn && cursor != start {
+                output.push(2.into());
+                point(&mut data, matrix, start);
+            }
+            cursor = p;
+            start = p;
+            pending_move = Some(p);
+            drawn = false;
+            continue;
+        }
+        if let Some(p) = pending_move.take() {
+            output.push(1.into());
+            point(&mut data, matrix, p);
+        }
+        match command {
+            DrawCommand::MoveTo(_) => unreachable!(),
+            DrawCommand::LineTo(p) => {
+                output.push(2.into());
+                point(&mut data, matrix, p);
+                cursor = p;
+            }
+            DrawCommand::QuadraticCurveTo { control, anchor } => {
+                output.push(3.into());
+                point(&mut data, matrix, control);
+                point(&mut data, matrix, anchor);
+                cursor = anchor;
+            }
+            DrawCommand::CubicCurveTo {
+                control_a,
+                control_b,
+                anchor,
+            } => {
+                let coords = [cursor, control_a, control_b, anchor]
+                    .map(|p| (p.x.to_pixels(), p.y.to_pixels()));
+                let cubic = |t: f64| {
+                    let u = 1.0 - t;
+                    (
+                        u * u * u * coords[0].0
+                            + 3.0 * u * u * t * coords[1].0
+                            + 3.0 * u * t * t * coords[2].0
+                            + t * t * t * coords[3].0,
+                        u * u * u * coords[0].1
+                            + 3.0 * u * u * t * coords[1].1
+                            + 3.0 * u * t * t * coords[2].1
+                            + t * t * t * coords[3].1,
+                    )
+                };
+                let error = (coords[0].0 - 3.0 * coords[1].0 + 3.0 * coords[2].0 - coords[3].0)
+                    .abs()
+                    .max((coords[0].1 - 3.0 * coords[1].1 + 3.0 * coords[2].1 - coords[3].1).abs());
+                let mut pieces = 1usize;
+                while pieces < 1024
+                    && error / (24.0 * 3.0f64.sqrt() * (pieces as f64).powi(3)) > 0.05
+                {
+                    pieces *= 2;
+                }
+                for n in 0..pieces {
+                    let from = cubic(n as f64 / pieces as f64);
+                    let mid = cubic((n as f64 + 0.5) / pieces as f64);
+                    let to = cubic((n + 1) as f64 / pieces as f64);
+                    let rounded = |x: f64, y: f64| {
+                        Point::new(
+                            Twips::new((x * 20.0).round() as i32),
+                            Twips::new((y * 20.0).round() as i32),
+                        )
+                    };
+                    let control = rounded(
+                        2.0 * mid.0 - (from.0 + to.0) / 2.0,
+                        2.0 * mid.1 - (from.1 + to.1) / 2.0,
+                    );
+                    output.push(3.into());
+                    point(&mut data, matrix, control);
+                    point(&mut data, matrix, rounded(to.0, to.1));
+                }
+                cursor = anchor;
+            }
+        }
+        drawn = true;
+    }
+    if close && drawn && cursor != start {
+        output.push(2.into());
+        point(&mut data, matrix, start);
+    }
+    if output.is_empty() {
+        return Ok(None);
+    }
+    let ints = a.avm2().class_defs().int;
+    let numbers = a.avm2().class_defs().number;
+    let commands =
+        VectorObject::from_vector(VectorStorage::from_values(output, false, Some(ints)), a).into();
+    let data =
+        VectorObject::from_vector(VectorStorage::from_values(data, false, Some(numbers)), a).into();
+    let winding = string(
+        a,
+        if winding == FillRule::EvenOdd {
+            "evenOdd"
+        } else {
+            "nonZero"
+        },
+    );
+    construct(a, "flash.display::GraphicsPath", &[commands, data, winding]).map(Some)
+}
+
+pub(super) fn read<'gc>(
+    a: &mut Activation<'_, 'gc>,
+    this: Value<'gc>,
+    recurse: bool,
+) -> Result<Value<'gc>, Error<'gc>> {
+    let mut output = Vec::new();
+    let mut pending = Vec::new();
+    let root = this.as_object().and_then(|o| o.as_display_object());
+    if let Some(owner) = root {
+        pending.push((owner, Matrix::IDENTITY, ColorTransform::IDENTITY));
+    }
+    let mut visited = 0;
+    while let Some((owner, matrix, color_transform)) = pending.pop() {
+        if !owner.visible() {
+            continue;
+        }
+        visited += 1;
+        let drawing = match owner {
+            DisplayObject::Graphic(graphic) => Some(graphic.drawing_snapshot()),
+            DisplayObject::MovieClip(clip) => clip.drawing().map(|drawing| drawing.clone()),
+            _ => None,
+        };
+        if let Some(drawing) = drawing {
+            let bitmaps = drawing.bitmap_infos();
+            for part in drawing.export_paths() {
+                match part {
+                    DrawPath::Fill {
+                        style,
+                        commands,
+                        winding_rule,
+                    } => {
+                        let Some(p) = path(a, commands, matrix, winding_rule, true)? else {
+                            continue;
+                        };
+                        if let Some(f) = fill(a, owner, style, matrix, color_transform, bitmaps)? {
+                            output.push(f);
+                            output.push(p);
+                            output.push(construct(a, "flash.display::GraphicsEndFill", &[])?);
+                        }
+                    }
+                    DrawPath::Stroke {
+                        style, commands, ..
+                    } => {
+                        let Some(p) = path(a, commands, matrix, FillRule::NonZero, false)? else {
+                            continue;
+                        };
+                        if let Some(f) = fill(
+                            a,
+                            owner,
+                            style.fill_style(),
+                            matrix,
+                            color_transform,
+                            bitmaps,
+                        )? {
+                            let normal = string(a, "normal");
+                            let none = string(a, "none");
+                            let round = string(a, "round");
+                            let scale = ((matrix.a * matrix.a
+                                + matrix.b * matrix.b
+                                + matrix.c * matrix.c
+                                + matrix.d * matrix.d)
+                                / 2.0)
+                                .sqrt() as f64;
+                            let width =
+                                Twips::new((style.width().get() as f64 * scale).round() as i32)
+                                    .to_pixels();
+                            output.push(construct(
+                                a,
+                                "flash.display::GraphicsStroke",
+                                &[
+                                    width.into(),
+                                    false.into(),
+                                    normal,
+                                    none,
+                                    round,
+                                    3.0.into(),
+                                    f,
+                                ],
+                            )?);
+                            output.push(p);
+                            output.push(construct(a, "flash.display::GraphicsStroke", &[])?);
+                            output.push(construct(a, "flash.display::GraphicsEndFill", &[])?);
+                        }
+                    }
+                }
+            }
+        }
+        if recurse {
+            if let Some(container) = owner.as_container() {
+                for child in container.iter_render_list().rev() {
+                    pending.push((
+                        child,
+                        matrix * child.base().matrix(),
+                        color_transform * child.base().color_transform(),
+                    ));
+                }
+            }
+        }
+    }
+    static READS: AtomicUsize = AtomicUsize::new(0);
+    if std::env::var_os("BLITZ_GRAPHICS_DEBUG").is_some()
+        && READS.fetch_add(1, Ordering::Relaxed) < 200
+    {
+        tracing::info!(
+            "BLITZ_GRAPHICS_READ owner={:?} id={:?} recurse={} visited={} output={}",
+            root.and_then(|o| o.name())
+                .map(|n| n.to_utf8_lossy().into_owned()),
+            root.map(|o| o.id()),
+            recurse,
+            visited,
+            output.len()
+        );
+    }
+    let kind = a.avm2().class_defs().igraphicsdata;
+    Ok(VectorObject::from_vector(VectorStorage::from_values(output, false, Some(kind)), a).into())
+}
