+use ruffle_core::{Player, external::Value as External};
+use serde_json::Value;
+use std::{
+    collections::BTreeMap,
+    time::{Duration, Instant},
+};
+use winit::{
+    event::{ElementState, KeyEvent},
+    keyboard::{Key, ModifiersState, PhysicalKey},
+};
+
+pub fn valid_binding(key: &str) -> bool {
+    if key == "ö" {
+        return true;
+    }
+    if let Some(letter) = key.strip_prefix("Key") {
+        return letter.len() == 1 && letter.bytes().all(|c| c.is_ascii_uppercase());
+    }
+    if let Some(digit) = key
+        .strip_prefix("Digit")
+        .or_else(|| key.strip_prefix("Numpad"))
+    {
+        if digit.len() == 1 && digit.bytes().all(|c| c.is_ascii_digit()) {
+            return true;
+        }
+    }
+    if let Some(number) = key.strip_prefix('F') {
+        return number
+            .parse::<u8>()
+            .is_ok_and(|n| (1..=24).contains(&n) && n != 11);
+    }
+    [
+        "Space",
+        "Tab",
+        "Enter",
+        "Backspace",
+        "Insert",
+        "Delete",
+        "Home",
+        "End",
+        "PageUp",
+        "PageDown",
+        "ArrowLeft",
+        "ArrowUp",
+        "ArrowRight",
+        "ArrowDown",
+        "CapsLock",
+        "Semicolon",
+        "Equal",
+        "Comma",
+        "Minus",
+        "Period",
+        "Slash",
+        "Backquote",
+        "BracketLeft",
+        "Backslash",
+        "BracketRight",
+        "Quote",
+        "NumpadMultiply",
+        "NumpadAdd",
+        "NumpadSubtract",
+        "NumpadDecimal",
+        "NumpadDivide",
+    ]
+    .contains(&key)
+}
+
+pub struct Controls {
+    pending: BTreeMap<String, Value>,
+    zoom: f64,
+    density: f64,
+    key: String,
+    autorun: bool,
+    held: bool,
+    mount: bool,
+    mount_held: bool,
+    last_apply: Option<Instant>,
+    client_ready: bool,
+    audio_ready: bool,
+}
+impl Default for Controls {
+    fn default() -> Self {
+        Self {
+            pending: BTreeMap::new(),
+            zoom: 1.0,
+            density: 1.0,
+            key: "ö".into(),
+            autorun: true,
+            held: false,
+            mount: false,
+            mount_held: false,
+            last_apply: None,
+            client_ready: false,
+            audio_ready: false,
+        }
+    }
+}
+fn call(player: &mut Player, name: &str, args: impl IntoIterator<Item = External>) -> bool {
+    matches!(
+        player.call_internal_interface(name, args.into_iter()),
+        External::Bool(true)
+    )
+}
+impl Controls {
+    pub fn blur(&mut self) {
+        self.held = false;
+        self.mount_held = false;
+    }
+    pub fn stop(&mut self, player: &mut Player) {
+        self.blur();
+        call(player, "BlitzStopAutorun", []);
+    }
+    pub fn invalidate(&mut self) {
+        self.pending.insert(
+            "zoom".into(),
+            serde_json::json!({"type":"zoom","value":self.zoom}),
+        );
+        self.last_apply = None;
+    }
+    pub fn command(&mut self, value: &Value, player: &mut Player) {
+        let kind = value["type"].as_str().unwrap();
+        match kind {
+            "zoom" => {
+                self.zoom = value["value"].as_f64().unwrap();
+                self.invalidate();
+            }
+            "render-resolution" => {
+                self.density = value["value"].as_f64().unwrap();
+                self.invalidate();
+            }
+            "autorun" => {
+                let enabled = value["value"].as_bool().unwrap();
+                let key = value["key"].as_str().unwrap();
+                if self.autorun != enabled || self.key != key {
+                    self.stop(player);
+                }
+                self.autorun = enabled;
+                self.key = key.into();
+            }
+            "shift-mount" => {
+                self.mount = value["value"].as_bool().unwrap();
+                self.mount_held = false;
+                self.pending.insert(kind.into(), value.clone());
+            }
+            "background" => {}
+            "crosshair" => {}
+            _ => {
+                self.pending.insert(kind.into(), value.clone());
+            }
+        }
+        self.last_apply = None;
+    }
+    pub fn apply(&mut self, player: &mut Player, dpi: f64) {
+        if self
+            .last_apply
+            .is_some_and(|t| t.elapsed() < Duration::from_millis(100))
+        {
+            return;
+        }
+        self.last_apply = Some(Instant::now());
+        let mut done = Vec::new();
+        for (kind, value) in &self.pending {
+            let value = &value["value"];
+            let applied = match kind.as_str() {
+                "zoom" => call(
+                    player,
+                    "BlitzSetPictureZoom",
+                    [
+                        External::Number(self.zoom),
+                        External::Number(dpi * self.density),
+                    ],
+                ),
+                "show-fps" => call(
+                    player,
+                    "BlitzShowFPS",
+                    [External::Bool(value.as_bool().unwrap())],
+                ),
+                "widescreen" => call(
+                    player,
+                    "BlitzSetWidescreen",
+                    [External::Bool(value.as_bool().unwrap())],
+                ),
+                "centered-hotbar" => call(
+                    player,
+                    "BlitzSetCenteredHotbar",
+                    [External::Bool(value.as_bool().unwrap())],
+                ),
+                "centered-camera" => call(
+                    player,
+                    "BlitzSetCenteredCamera",
+                    [External::Bool(value.as_bool().unwrap())],
+                ),
+                "shift-mount" => call(
+                    player,
+                    "BlitzSetMountShortcut",
+                    [External::Bool(value.as_bool().unwrap())],
+                ),
+                "audio-mix" => call(
+                    player,
+                    "BlitzSetAudio",
+                    ["player", "music", "environment", "creatures"]
+                        .map(|k| External::Number(value[k].as_f64().unwrap())),
+                ),
+                _ => false,
+            };
+            if applied {
+                done.push(kind.clone());
+                crate::launcher_host::emit(
+                    serde_json::json!({"type":"applied","command":kind,"value":true}),
+                );
+                if kind == "zoom" && !self.client_ready {
+                    self.client_ready = true;
+                    crate::launcher_host::emit(
+                        serde_json::json!({"type":"client-integration","value":true}),
+                    );
+                    crate::launcher_host::emit(serde_json::json!({"type":"loading","value":false}));
+                }
+                if kind == "audio-mix" && !self.audio_ready {
+                    self.audio_ready = true;
+                    crate::launcher_host::emit(
+                        serde_json::json!({"type":"audio-integration","value":true}),
+                    );
+                }
+            }
+        }
+        for kind in done {
+            self.pending.remove(&kind);
+        }
+    }
+    pub fn key(&mut self, event: &KeyEvent, modifiers: ModifiersState, player: &mut Player) {
+        let code = match event.physical_key {
+            PhysicalKey::Code(code) => format!("{code:?}"),
+            _ => String::new(),
+        };
+        let typed = match &event.logical_key {
+            Key::Character(value) => value.as_str(),
+            _ => "",
+        };
+        self.shortcut(
+            typed,
+            &code,
+            event.state == ElementState::Pressed,
+            event.repeat,
+            modifiers.control_key() || modifiers.alt_key() || modifiers.super_key(),
+            modifiers.shift_key(),
+            player,
+        );
+    }
+    fn shortcut(
+        &mut self,
+        typed: &str,
+        code: &str,
+        down: bool,
+        repeat: bool,
+        chord: bool,
+        shift: bool,
+        player: &mut Player,
+    ) {
+        if down && !repeat && !chord {
+            crate::launcher_host::gesture();
+        }
+        if code == "ShiftLeft" {
+            if !down {
+                self.mount_held = false;
+            } else if !repeat && !self.mount_held {
+                self.mount_held = true;
+                if self.mount && !chord {
+                    call(player, "BlitzMount", []);
+                }
+            }
+        }
+        let matches = if self.key == "ö" {
+            typed.to_lowercase() == "ö"
+        } else {
+            code == self.key
+        };
+        if !matches {
+            return;
+        }
+        if !down {
+            self.held = false;
+            return;
+        }
+        if repeat || self.held {
+            return;
+        }
+        self.held = true;
+        if self.autorun && !chord && (self.key == "ö" || !shift) {
+            call(player, "BlitzAutorun", []);
+        }
+    }
+    pub fn fixture_key(&mut self, args: &[External], player: &mut Player) -> bool {
+        let [
+            External::String(typed),
+            External::String(code),
+            External::Bool(down),
+            External::Bool(repeat),
+            External::Bool(chord),
+            External::Bool(shift),
+        ] = args
+        else {
+            return false;
+        };
+        if typed.len() > 16 || code.len() > 32 {
+            return false;
+        }
+        self.shortcut(typed, code, *down, *repeat, *chord, *shift, player);
+        true
+    }
+}
diff --git a/desktop/src/launcher_host.rs b/desktop/src/launcher_host.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b7cfaf4471b0fbf93ee645dc41675c93d351fc8c
--- /dev/null
+++ b/desktop/src/launcher_host.rs
@@ -0,0 +1,203 @@
+//! Authenticated, bounded transport for the dedicated launcher and private fixtures.
+use crate::custom_event::RuffleEvent;
+use serde_json::{Value, json};
+use std::sync::{Arc, LazyLock, Mutex, OnceLock};
+use std::time::Duration;
+use tokio::io::{AsyncBufReadExt, AsyncReadExt, AsyncWriteExt, BufReader};
+use tokio::sync::mpsc;
+use winit::event_loop::EventLoopProxy;
+
+pub struct Channel {
+    output: mpsc::Sender<Value>,
+}
+impl Channel {
+    pub fn send(&self, value: Value) -> bool {
+        if value.to_string().len() > 32768 {
+            return false;
+        }
+        self.output.try_send(value).is_ok()
+    }
+}
+
+pub fn fixture() -> bool {
+    std::env::var("BLITZ_HOST_TEST").as_deref() == Ok("1")
+        && std::env::var("BLITZ_PRIVATE_DESKTOP").is_ok_and(|n| n.starts_with("BlitzTest-"))
+}
+fn configuration() -> Option<(String, String)> {
+    if !fixture() && std::env::var("BLITZ_NATIVE_PLAYER").as_deref() != Ok("120") {
+        return None;
+    }
+    let pipe = std::env::var("BLITZ_HOST_CHANNEL").ok()?;
+    let token = std::env::var("BLITZ_HOST_TOKEN").ok()?;
+    let suffix = pipe.strip_prefix("\\\\.\\pipe\\blitz-game-")?;
+    if suffix.len() != 48
+        || !suffix.bytes().all(|b| b.is_ascii_hexdigit())
+        || token.len() != 64
+        || !token.bytes().all(|b| b.is_ascii_hexdigit())
+    {
+        return None;
+    }
+    Some((pipe, token))
+}
+pub fn configured() -> bool {
+    static ENABLED: LazyLock<bool> = LazyLock::new(|| configuration().is_some());
+    *ENABLED
+}
+pub fn production() -> bool {
+    static ENABLED: LazyLock<bool> = LazyLock::new(|| {
+        configured() && std::env::var("BLITZ_NATIVE_PLAYER").as_deref() == Ok("120")
+    });
+    *ENABLED
+}
+static CHANNEL: OnceLock<Arc<Channel>> = OnceLock::new();
+static LAST_GESTURE: Mutex<Option<std::time::Instant>> = Mutex::new(None);
+pub fn set_channel(channel: Arc<Channel>) {
+    let _ = CHANNEL.set(channel);
+}
+pub fn emit(value: Value) {
+    if let Some(channel) = CHANNEL.get() {
+        channel.send(value);
+    }
+}
+pub fn gesture() {
+    *LAST_GESTURE.lock().unwrap() = Some(std::time::Instant::now());
+}
+pub fn navigate(url: url::Url) {
+    if url.as_str().len() > 2048
+        || !LAST_GESTURE
+            .lock()
+            .unwrap()
+            .is_some_and(|t| t.elapsed() < Duration::from_secs(1))
+    {
+        return;
+    }
+    // The shell independently checks the destination against its link policy.
+    emit(json!({"type":"external-link","url":url.as_str(),"userGesture":true}));
+}
+
+pub fn valid_command(value: &Value) -> bool {
+    let Some(object) = value.as_object() else {
+        return false;
+    };
+    let Some(kind) = object.get("type").and_then(Value::as_str) else {
+        return false;
+    };
+    match kind {
+        "quit" | "focus" => object.len() == 1,
+        "visibility" | "show-fps" | "widescreen" | "centered-hotbar" | "centered-camera"
+        | "shift-mount" | "background" => {
+            object.len() == 2 && value.get("value").is_some_and(Value::is_boolean)
+        }
+        "zoom" => {
+            object.len() == 2
+                && value
+                    .get("value")
+                    .and_then(Value::as_f64)
+                    .is_some_and(|v| (0.5..=3.0).contains(&v))
+        }
+        "render-resolution" => {
+            object.len() == 2
+                && value
+                    .get("value")
+                    .and_then(Value::as_f64)
+                    .is_some_and(|v| [0.5, 0.75, 1.0].contains(&v))
+        }
+        "autorun" => {
+            object.len() == 3
+                && value["value"].is_boolean()
+                && value["key"]
+                    .as_str()
+                    .is_some_and(crate::launcher_controls::valid_binding)
+        }
+        "audio-mix" => {
+            object.len() == 2
+                && value["value"].as_object().is_some_and(|o| {
+                    o.len() == 4
+                        && ["player", "music", "environment", "creatures"]
+                            .iter()
+                            .all(|k| o.get(*k).and_then(Value::as_u64).is_some_and(|v| v <= 100))
+                })
+        }
+        // Custom cursor drawing is not supported by this player yet. A disabled
+        // setting is accepted so a profile can switch renderers without edits.
+        "crosshair" => object.len() == 2 && value["value"].is_object(),
+        "viewport" => {
+            object.len() == 3
+                && matches!((value.get("width").and_then(Value::as_u64),value.get("height").and_then(Value::as_u64)),(Some(w),Some(h))if(16..=8192).contains(&w)&&(16..=8192).contains(&h)&&w*h<=8_388_608)
+        }
+        _ => false,
+    }
+}
+
+#[cfg(windows)]
+pub fn start(proxy: EventLoopProxy<RuffleEvent>, runtime: &tokio::runtime::Handle) {
+    let Some((pipe, token)) = configuration() else {
+        return;
+    };
+    runtime.spawn(async move {
+        use tokio::net::windows::named_pipe::ClientOptions;
+        let mut client = None;
+        for _ in 0..100 {
+            if let Ok(value) = ClientOptions::new().open(&pipe) {
+                client = Some(value);
+                break;
+            }
+            tokio::time::sleep(Duration::from_millis(50)).await;
+        }
+        let Some(client) = client else {
+            let _ = proxy.send_event(RuffleEvent::ExitRequested);
+            return;
+        };
+        let (input, mut output) = tokio::io::split(client);
+        let auth = json!({"type":"auth","token":token}).to_string() + "\n";
+        if output.write_all(auth.as_bytes()).await.is_err() {
+            let _ = proxy.send_event(RuffleEvent::ExitRequested);
+            return;
+        }
+        let (send, mut receive) = mpsc::channel::<Value>(64);
+        let channel = Arc::new(Channel { output: send });
+        if proxy
+            .send_event(RuffleEvent::LauncherConnected(channel))
+            .is_err()
+        {
+            return;
+        }
+        let writer_proxy = proxy.clone();
+        let writer = tokio::spawn(async move {
+            while let Some(value) = receive.recv().await {
+                let line = value.to_string() + "\n";
+                if line.len() > 32769 || output.write_all(line.as_bytes()).await.is_err() {
+                    break;
+                }
+            }
+            let _ = writer_proxy.send_event(RuffleEvent::ExitRequested);
+        });
+        let mut input = BufReader::new(input);
+        loop {
+            let mut line = Vec::new();
+            let read = (&mut input).take(32769).read_until(b'\n', &mut line).await;
+            if !read.is_ok_and(|n| n > 0 && n <= 32769)
+                || line.len() > 32768
+                || line.last() != Some(&b'\n')
+            {
+                break;
+            }
+            let Ok(command) = serde_json::from_slice::<Value>(&line) else {
+                break;
+            };
+            if !valid_command(&command) {
+                break;
+            }
+            if proxy
+                .send_event(RuffleEvent::LauncherCommand(command))
+                .is_err()
+            {
+                break;
+            }
+        }
+        writer.abort();
+        let _ = proxy.send_event(RuffleEvent::ExitRequested);
+    });
+}
+#[cfg(not(windows))]
+pub fn start(_proxy: EventLoopProxy<RuffleEvent>, _runtime: &tokio::runtime::Handle) {}
