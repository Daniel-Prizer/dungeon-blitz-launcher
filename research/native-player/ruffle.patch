diff --git a/core/src/fps_research.rs b/core/src/fps_research.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b3aa27e313ac60e0fe1bba097d60bd4d1a409f1f
--- /dev/null
+++ b/core/src/fps_research.rs
@@ -0,0 +1,16 @@
+use std::sync::{LazyLock,Mutex};
+use web_time::Instant;
+static ENABLED:LazyLock<bool>=LazyLock::new(||std::env::var_os("BLITZ_FPS_PROOF_DIR").is_some());
+static RETAIN_BACKLOG:LazyLock<bool>=LazyLock::new(||std::env::var_os("BLITZ_FPS_RETAIN_BACKLOG").is_some());
+static SEQUENTIAL:LazyLock<bool>=LazyLock::new(||std::env::var_os("BLITZ_FPS_SEQUENTIAL").is_some());
+pub fn retain_backlog()->bool{*ENABLED&&*RETAIN_BACKLOG}
+pub fn sequential()->bool{*ENABLED&&*SEQUENTIAL}
+static CLOCK:LazyLock<Instant>=LazyLock::new(Instant::now);
+static COUNTS:LazyLock<Mutex<std::collections::BTreeMap<&'static str,(u64,u128,u128,u128)>>>=LazyLock::new(||Mutex::new(Default::default()));
+pub fn cost(name:&'static str,started:Instant){
+ if !*ENABLED{return;}
+ let elapsed=started.elapsed().as_micros();let now=CLOCK.elapsed().as_micros();
+ let mut all=COUNTS.lock().expect("owned core probe");let counter=all.entry(name).or_insert((0,0,0,now));
+ counter.0+=1;counter.1+=elapsed;counter.2=counter.2.max(elapsed);
+ if now-counter.3>=1_000_000 {tracing::info!("BLITZ_CORE_COST stage={} calls={} meanUs={} maxUs={}",name,counter.0,counter.1/counter.0 as u128,counter.2);*counter=(0,0,0,now);}
+}
