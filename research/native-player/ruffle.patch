+++ b/desktop/src/fixture_control.rs
@@ -0,0 +1,228 @@
+use crate::custom_event::RuffleEvent;
+use ruffle_core::external::Value as External;
+use serde_json::{Value, json};
+use std::collections::BTreeMap;
+use std::io::{BufRead, Read, Write};
+use std::sync::mpsc::{SyncSender, sync_channel};
+use std::time::Duration;
+use winit::event_loop::EventLoopProxy;
+
+// Lab control for known, unauthenticated SWFs. Never enabled by the product.
+pub struct Request {
+    pub id: u64,
+    pub name: String,
+    pub arguments: Vec<External>,
+    pub done: SyncSender<()>,
+}
+
+pub fn input(name: &str, args: &[External]) -> Option<ruffle_core::PlayerEvent> {
+    use ruffle_core::events::{
+        KeyDescriptor, KeyLocation, LogicalKey, MouseButton, NamedKey, PhysicalKey, PlayerEvent,
+    };
+    match (name, args) {
+        ("BlitzFixtureFocus", [External::Bool(true)]) => Some(PlayerEvent::FocusGained),
+        ("BlitzFixtureFocus", [External::Bool(false)]) => Some(PlayerEvent::FocusLost),
+        (
+            "BlitzFixtureMouse",
+            [
+                External::String(kind),
+                External::Number(x),
+                External::Number(y),
+            ],
+        ) if x.is_finite()
+            && y.is_finite()
+            && *x >= 0.0
+            && *y >= 0.0
+            && *x <= 4096.0
+            && *y <= 4096.0 =>
+        {
+            match kind.as_str() {
+                "move" => Some(PlayerEvent::MouseMove { x: *x, y: *y }),
+                "down" => Some(PlayerEvent::MouseDown {
+                    x: *x,
+                    y: *y,
+                    button: MouseButton::Left,
+                    index: Some(0),
+                }),
+                "up" => Some(PlayerEvent::MouseUp {
+                    x: *x,
+                    y: *y,
+                    button: MouseButton::Left,
+                }),
+                _ => None,
+            }
+        }
+        ("BlitzFixtureKey", [External::Bool(down), External::String(name)]) => {
+            let (physical_key, logical_key) = match name.as_str() {
+                "right" => (
+                    PhysicalKey::ArrowRight,
+                    LogicalKey::Named(NamedKey::ArrowRight),
+                ),
+                "left" => (
+                    PhysicalKey::ArrowLeft,
+                    LogicalKey::Named(NamedKey::ArrowLeft),
+                ),
+                "escape" => (PhysicalKey::Escape, LogicalKey::Named(NamedKey::Escape)),
+                "enter" => (PhysicalKey::Enter, LogicalKey::Named(NamedKey::Enter)),
+                "a" => (PhysicalKey::KeyA, LogicalKey::Character('a')),
+                "ö" => (PhysicalKey::Semicolon, LogicalKey::Character('ö')),
+                _ => return None,
+            };
+            let key = KeyDescriptor {
+                physical_key,
+                logical_key,
+                key_location: KeyLocation::Standard,
+            };
+            Some(if *down {
+                PlayerEvent::KeyDown { key }
+            } else {
+                PlayerEvent::KeyUp { key }
+            })
+        }
+        _ => None,
+    }
+}
+
+pub fn size(args: &[External]) -> Option<winit::dpi::PhysicalSize<u32>> {
+    match args {
+        [External::Number(width), External::Number(height)]
+            if width.is_finite()
+                && height.is_finite()
+                && *width >= 320.0
+                && *height >= 240.0
+                && *width <= 4096.0
+                && *height <= 2160.0
+                && width * height <= 8_388_608.0 =>
+        {
+            Some(winit::dpi::PhysicalSize::new(*width as u32, *height as u32))
+        }
+        _ => None,
+    }
+}
+
+fn from_json(value: &Value, depth: usize) -> Option<External> {
+    if depth > 16 {
+        return None;
+    }
+    Some(match value {
+        Value::Null => External::Null,
+        Value::Bool(value) => External::Bool(*value),
+        Value::Number(value) => External::Number(value.as_f64()?),
+        Value::String(value) => External::String(value.clone()),
+        Value::Array(value) => External::List(
+            value
+                .iter()
+                .map(|value| from_json(value, depth + 1))
+                .collect::<Option<_>>()?,
+        ),
+        Value::Object(value) => External::Object(
+            value
+                .iter()
+                .map(|(key, value)| Some((key.clone(), from_json(value, depth + 1)?)))
+                .collect::<Option<BTreeMap<_, _>>>()?,
+        ),
+    })
+}
+
+fn to_json(value: External, depth: usize) -> Option<Value> {
+    if depth > 16 {
+        return None;
+    }
+    Some(match value {
+        External::Undefined | External::Null => Value::Null,
+        External::Bool(value) => json!(value),
+        External::Number(value) => json!(value),
+        External::String(value) => json!(value),
+        External::List(value) => Value::Array(
+            value
+                .into_iter()
+                .map(|value| to_json(value, depth + 1))
+                .collect::<Option<_>>()?,
+        ),
+        External::Object(value) => Value::Object(
+            value
+                .into_iter()
+                .map(|(key, value)| Some((key, to_json(value, depth + 1)?)))
+                .collect::<Option<_>>()?,
+        ),
+    })
+}
+
+pub fn respond(request: Request, result: Option<External>) {
+    let value = result.and_then(|value| to_json(value, 0));
+    let response = json!({"id":request.id,"ok":value.is_some(),"value":value});
+    let output = response.to_string();
+    if output.len() <= 32768 {
+        let mut stream = std::io::stdout().lock();
+        let _ = writeln!(stream, "BLITZ_RPC {output}");
+        let _ = stream.flush();
+    }
+    let _ = request.done.send(());
+}
+
+pub fn start(proxy: EventLoopProxy<RuffleEvent>) {
+    if std::env::var_os("BLITZ_FIXTURE_CONTROL").is_none()
+        || !std::env::var("BLITZ_PRIVATE_DESKTOP").is_ok_and(|name| name.starts_with("BlitzTest-"))
+    {
+        return;
+    }
+    std::thread::spawn(move || {
+        let mut input = std::io::stdin().lock();
+        loop {
+            let mut line = Vec::new();
+            let read = (&mut input).take(32769).read_until(b'\n', &mut line);
+            if !read.is_ok_and(|length| length > 0 && length <= 32768)
+                || line.last() != Some(&b'\n')
+            {
+                break;
+            }
+            let Ok(value) = serde_json::from_slice::<Value>(&line) else {
+                break;
+            };
+            let Some(id) = value.get("id").and_then(Value::as_u64) else {
+                break;
+            };
+            let Some(name) = value.get("name").and_then(Value::as_str) else {
+                break;
+            };
+            if name == "CloseFixture" {
+                let _ = proxy.send_event(RuffleEvent::ExitRequested);
+                return;
+            }
+            if name.len() > 64
+                || !name.starts_with("Blitz")
+                || !name.bytes().all(|byte| byte.is_ascii_alphanumeric())
+            {
+                break;
+            }
+            let Some(values) = value.get("args").and_then(Value::as_array) else {
+                break;
+            };
+            if values.len() > 16 {
+                break;
+            }
+            let Some(arguments) = values
+                .iter()
+                .map(|value| from_json(value, 0))
+                .collect::<Option<Vec<_>>>()
+            else {
+                break;
+            };
+            let (done, wait) = sync_channel(1);
+            let request = Request {
+                id,
+                name: name.to_owned(),
+                arguments,
+                done,
+            };
+            if proxy
+                .send_event(RuffleEvent::FixtureControl(request))
+                .is_err()
+                || wait.recv_timeout(Duration::from_secs(5)).is_err()
+            {
+                break;
+            }
+        }
+        let _ = proxy.send_event(RuffleEvent::ExitRequested);
+    });
+}
