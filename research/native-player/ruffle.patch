diff --git a/desktop/src/launcher_controls.rs b/desktop/src/launcher_controls.rs
new file mode 100644
index 0000000000000000000000000000000000000000..17a2c57a0c6716430d30832323c6f6e168229d03
--- /dev/null
+++ b/desktop/src/launcher_controls.rs
@@ -0,0 +1,384 @@
+use ruffle_core::{Player, external::Value as External};
+use serde_json::Value;
+use std::{
+    collections::BTreeMap,
+    time::{Duration, Instant},
+};
+use winit::{
+    event::{ElementState, KeyEvent},
+    keyboard::{Key, ModifiersState, PhysicalKey},
+};
+
+pub fn valid_binding(key: &str) -> bool {
+    if key == "ö" {
+        return true;
+    }
+    if let Some(letter) = key.strip_prefix("Key") {
+        return letter.len() == 1 && letter.bytes().all(|c| c.is_ascii_uppercase());
+    }
+    if let Some(digit) = key
+        .strip_prefix("Digit")
+        .or_else(|| key.strip_prefix("Numpad"))
+    {
+        if digit.len() == 1 && digit.bytes().all(|c| c.is_ascii_digit()) {
+            return true;
+        }
+    }
+    if let Some(number) = key.strip_prefix('F') {
+        return number
+            .parse::<u8>()
+            .is_ok_and(|n| (1..=24).contains(&n) && n != 11);
+    }
+    [
+        "Space",
+        "Tab",
+        "Enter",
+        "Backspace",
+        "Insert",
+        "Delete",
+        "Home",
+        "End",
+        "PageUp",
+        "PageDown",
+        "ArrowLeft",
+        "ArrowUp",
+        "ArrowRight",
+        "ArrowDown",
+        "CapsLock",
+        "Semicolon",
+        "Equal",
+        "Comma",
+        "Minus",
+        "Period",
+        "Slash",
+        "Backquote",
+        "BracketLeft",
+        "Backslash",
+        "BracketRight",
+        "Quote",
+        "NumpadMultiply",
+        "NumpadAdd",
+        "NumpadSubtract",
+        "NumpadDecimal",
+        "NumpadDivide",
+    ]
+    .contains(&key)
+}
+
+pub struct Controls {
+    pending: BTreeMap<String, Value>,
+    desired: BTreeMap<String, Value>,
+    session: Option<f64>,
+    last_session_check: Option<Instant>,
+    last_render_sample: u64,
+    zoom: f64,
+    density: f64,
+    key: String,
+    autorun: bool,
+    held: bool,
+    mount: bool,
+    mount_held: bool,
+    last_apply: Option<Instant>,
+    client_ready: bool,
+    audio_ready: bool,
+}
+impl Default for Controls {
+    fn default() -> Self {
+        Self {
+            pending: BTreeMap::new(),
+            desired: BTreeMap::new(),
+            session: None,
+            last_session_check: None,
+            last_render_sample: 0,
+            zoom: 1.0,
+            density: 1.0,
+            key: "ö".into(),
+            autorun: true,
+            held: false,
+            mount: false,
+            mount_held: false,
+            last_apply: None,
+            client_ready: false,
+            audio_ready: false,
+        }
+    }
+}
+fn call(player: &mut Player, name: &str, args: impl IntoIterator<Item = External>) -> bool {
+    matches!(
+        player.call_internal_interface(name, args.into_iter()),
+        External::Bool(true)
+    )
+}
+impl Controls {
+    pub fn blur(&mut self) {
+        self.held = false;
+        self.mount_held = false;
+    }
+    pub fn stop(&mut self, player: &mut Player) {
+        self.blur();
+        call(player, "BlitzStopAutorun", []);
+    }
+    pub fn invalidate(&mut self) {
+        self.pending.insert(
+            "zoom".into(),
+            serde_json::json!({"type":"zoom","value":self.zoom}),
+        );
+        self.last_apply = None;
+    }
+    pub fn command(&mut self, value: &Value, player: &mut Player) {
+        let kind = value["type"].as_str().unwrap();
+        if [
+            "show-fps",
+            "widescreen",
+            "centered-hotbar",
+            "centered-camera",
+            "shift-mount",
+            "audio-mix",
+        ]
+        .contains(&kind)
+        {
+            self.desired.insert(kind.into(), value.clone());
+        }
+        match kind {
+            "zoom" => {
+                self.zoom = value["value"].as_f64().unwrap();
+                self.invalidate();
+            }
+            "render-resolution" => {
+                self.density = value["value"].as_f64().unwrap();
+                self.invalidate();
+            }
+            "autorun" => {
+                let enabled = value["value"].as_bool().unwrap();
+                let key = value["key"].as_str().unwrap();
+                if self.autorun != enabled || self.key != key {
+                    self.stop(player);
+                }
+                self.autorun = enabled;
+                self.key = key.into();
+            }
+            "shift-mount" => {
+                self.mount = value["value"].as_bool().unwrap();
+                self.mount_held = false;
+                self.pending.insert(kind.into(), value.clone());
+            }
+            "frame-cap" => {
+                let cap = value["value"].as_f64().unwrap();
+                if player.set_presentation_rate(cap) {
+                    self.last_render_sample = 0;
+                    crate::fps_probe::set_cap(cap as u32);
+                }
+            }
+            "background" => {}
+            "crosshair" => {}
+            _ => {
+                self.pending.insert(kind.into(), value.clone());
+            }
+        }
+        self.last_apply = None;
+    }
+    pub fn apply(&mut self, player: &mut Player, dpi: f64) {
+        if self
+            .last_apply
+            .is_some_and(|t| t.elapsed() < Duration::from_millis(100))
+        {
+            return;
+        }
+        self.last_apply = Some(Instant::now());
+        // Use the stage's native viewport transform for lower raster density.
+        // Physical presentation and inverse pointer mapping retain the full window.
+        let magnification = dpi / self.density;
+        let mut viewport = player.viewport_dimensions();
+        if (viewport.scale_factor - magnification).abs() > 0.00001 {
+            viewport.scale_factor = magnification;
+            player.set_viewport_dimensions(viewport);
+            self.invalidate();
+        }
+        if self
+            .last_session_check
+            .is_none_or(|t| t.elapsed() >= Duration::from_millis(500))
+        {
+            self.last_session_check = Some(Instant::now());
+            if let External::Number(epoch) =
+                player.call_internal_interface("BlitzSettingsGeneration", std::iter::empty())
+            {
+                if self.session != Some(epoch) {
+                    self.session = Some(epoch);
+                    let resume = self.pending.remove("resume-character");
+                    self.pending = self.desired.clone();
+                    if let Some(resume) = resume {
+                        self.pending.insert("resume-character".into(), resume);
+                    }
+                    self.invalidate();
+                }
+            }
+        }
+        if let Some((serial, fps, low, high)) = crate::fps_probe::render_sample() {
+            if serial != self.last_render_sample {
+                self.last_render_sample = serial;
+                call(
+                    player,
+                    "BlitzRenderFPS",
+                    [
+                        External::Number(fps),
+                        External::Number(low),
+                        External::Number(high),
+                    ],
+                );
+            }
+        }
+        let mut done = Vec::new();
+        for (kind, value) in &self.pending {
+            let value = &value["value"];
+            let applied = match kind.as_str() {
+                "zoom" => call(
+                    player,
+                    "BlitzSetPictureZoom",
+                    [External::Number(self.zoom), External::Number(magnification)],
+                ),
+                "show-fps" => call(
+                    player,
+                    "BlitzShowFPS",
+                    [External::Bool(value.as_bool().unwrap())],
+                ),
+                "widescreen" => call(
+                    player,
+                    "BlitzSetWidescreen",
+                    [External::Bool(value.as_bool().unwrap())],
+                ),
+                "centered-hotbar" => call(
+                    player,
+                    "BlitzSetCenteredHotbar",
+                    [External::Bool(value.as_bool().unwrap())],
+                ),
+                "centered-camera" => call(
+                    player,
+                    "BlitzSetCenteredCamera",
+                    [External::Bool(value.as_bool().unwrap())],
+                ),
+                "shift-mount" => call(
+                    player,
+                    "BlitzSetMountShortcut",
+                    [External::Bool(value.as_bool().unwrap())],
+                ),
+                "audio-mix" => call(
+                    player,
+                    "BlitzSetAudio",
+                    ["player", "music", "environment", "creatures"]
+                        .map(|k| External::Number(value[k].as_f64().unwrap())),
+                ),
+                "resume-character" => call(
+                    player,
+                    "BlitzResumeCharacter",
+                    [
+                        External::Number(value["userID"].as_f64().unwrap()),
+                        External::String(value["name"].as_str().unwrap().into()),
+                    ],
+                ),
+                _ => false,
+            };
+            if applied {
+                done.push(kind.clone());
+                crate::launcher_host::emit(
+                    serde_json::json!({"type":"applied","command":kind,"value":true}),
+                );
+                if kind == "zoom" && !self.client_ready {
+                    self.client_ready = true;
+                    crate::launcher_host::emit(
+                        serde_json::json!({"type":"client-integration","value":true}),
+                    );
+                    crate::launcher_host::emit(serde_json::json!({"type":"loading","value":false}));
+                }
+                if kind == "audio-mix" && !self.audio_ready {
+                    self.audio_ready = true;
+                    crate::launcher_host::emit(
+                        serde_json::json!({"type":"audio-integration","value":true}),
+                    );
+                }
+            }
+        }
+        for kind in done {
+            self.pending.remove(&kind);
+        }
+    }
+    pub fn key(&mut self, event: &KeyEvent, modifiers: ModifiersState, player: &mut Player) {
+        let code = match event.physical_key {
+            PhysicalKey::Code(code) => format!("{code:?}"),
+            _ => String::new(),
+        };
+        let typed = match &event.logical_key {
+            Key::Character(value) => value.as_str(),
+            _ => "",
+        };
+        self.shortcut(
+            typed,
+            &code,
+            event.state == ElementState::Pressed,
+            event.repeat,
+            modifiers.control_key() || modifiers.alt_key() || modifiers.super_key(),
+            modifiers.shift_key(),
+            player,
+        );
+    }
+    fn shortcut(
+        &mut self,
+        typed: &str,
+        code: &str,
+        down: bool,
+        repeat: bool,
+        chord: bool,
+        shift: bool,
+        player: &mut Player,
+    ) {
+        if down && !repeat && !chord {
+            crate::launcher_host::gesture();
+        }
+        if code == "ShiftLeft" {
+            if !down {
+                self.mount_held = false;
+            } else if !repeat && !self.mount_held {
+                self.mount_held = true;
+                if self.mount && !chord {
+                    call(player, "BlitzMount", []);
+                }
+            }
+        }
+        let matches = if self.key == "ö" {
+            typed.to_lowercase() == "ö"
+        } else {
+            code == self.key
+        };
+        if !matches {
+            return;
+        }
+        if !down {
+            self.held = false;
+            return;
+        }
+        if repeat || self.held {
+            return;
+        }
+        self.held = true;
+        if self.autorun && !chord && (self.key == "ö" || !shift) {
+            call(player, "BlitzAutorun", []);
+        }
+    }
+    pub fn fixture_key(&mut self, args: &[External], player: &mut Player) -> bool {
+        let [
+            External::String(typed),
+            External::String(code),
+            External::Bool(down),
+            External::Bool(repeat),
+            External::Bool(chord),
+            External::Bool(shift),
+        ] = args
+        else {
+            return false;
+        };
+        if typed.len() > 16 || code.len() > 32 {
+            return false;
+        }
+        self.shortcut(typed, code, *down, *repeat, *chord, *shift, player);
+        true
+    }
+}
diff --git a/desktop/src/launcher_cursor.rs b/desktop/src/launcher_cursor.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b31b7b570e8cf0713baec90ba00a0be378c7c0f9
--- /dev/null
+++ b/desktop/src/launcher_cursor.rs
@@ -0,0 +1,557 @@
+use serde_json::Value;
+use std::cell::RefCell;
+use winit::{
+    event_loop::ActiveEventLoop,
+    window::{CursorIcon, CustomCursor, Window},
+};
+
+#[derive(Clone, Debug, PartialEq)]
+struct Settings {
+    style: String,
+    color: [u8; 3],
+    size: u16,
+    outline: bool,
+}
+impl Default for Settings {
+    fn default() -> Self {
+        Self {
+            style: "default".into(),
+            color: [140, 255, 101],
+            size: 24,
+            outline: true,
+        }
+    }
+}
+fn settings(v: &Value) -> Option<Settings> {
+    let o = v.as_object()?;
+    if o.len() != 4 {
+        return None;
+    }
+    let style = o.get("style")?.as_str()?;
+    if !["default", "original", "cross", "dot", "ring"].contains(&style) {
+        return None;
+    }
+    let hex = o.get("color")?.as_str()?;
+    if hex.len() != 7
+        || !hex.starts_with('#')
+        || !hex.as_bytes()[1..].iter().all(u8::is_ascii_hexdigit)
+    {
+        return None;
+    }
+    let color = [
+        u8::from_str_radix(&hex[1..3], 16).ok()?,
+        u8::from_str_radix(&hex[3..5], 16).ok()?,
+        u8::from_str_radix(&hex[5..7], 16).ok()?,
+    ];
+    let size = u16::try_from(o.get("size")?.as_u64()?).ok()?;
+    if ![16, 24, 32, 48].contains(&size) {
+        return None;
+    }
+    Some(Settings {
+        style: style.into(),
+        color,
+        size,
+        outline: o.get("outline")?.as_bool()?,
+    })
+}
+pub fn valid(v: &Value) -> bool {
+    settings(v).is_some()
+}
+
+#[derive(Default)]
+struct State {
+    settings: Settings,
+    cursor: Option<CustomCursor>,
+    hand: Option<CustomCursor>,
+    applied: Option<(egui::CursorIcon, bool)>,
+    pixels: Vec<u8>,
+    width: u16,
+    hotspot: (u16, u16),
+    generation: u64,
+    game: std::collections::HashMap<String, GameCursor>,
+    selected_game: Option<String>,
+    game_frame: usize,
+}
+thread_local! { static STATE:RefCell<State>=RefCell::new(State::default()); }
+
+fn raster(s: &Settings, dpi: f64) -> (u16, Vec<u8>) {
+    let scale = dpi.clamp(0.5, 3.0);
+    let width = (((s.size as f64 * scale / 2.0).round() as u16) * 2 + 1).min(145);
+    let center = (width - 1) as f64 / 2.0;
+    let radius = (width as f64 * 0.31).round().max(2.0);
+    let half = (scale.round() - 1.0).max(0.0);
+    let gap = (width as f64 * 0.1).round().max(2.0);
+    let n = width as usize;
+    let mut ink = vec![false; n * n];
+    let mut pixels = vec![0; n * n * 4];
+    for y in 0..n {
+        for x in 0..n {
+            let dx = (x as f64 - center).abs();
+            let dy = (y as f64 - center).abs();
+            let d = dx.hypot(dy);
+            ink[y * n + x] = match s.style.as_str() {
+                "cross" => {
+                    (dx <= half && dy >= gap && dy <= radius)
+                        || (dy <= half && dx >= gap && dx <= radius)
+                }
+                "dot" => d <= (width as f64 * 0.09).round().max(2.0),
+                "ring" => (d - radius).abs() <= 0.6_f64.max(scale * 0.7),
+                _ => false,
+            };
+        }
+    }
+    let edge = scale.ceil() as isize;
+    for y in 0..n {
+        for x in 0..n {
+            let i = y * n + x;
+            let mut border = false;
+            if s.outline && !ink[i] {
+                for j in -edge..=edge {
+                    for k in -edge..=edge {
+                        let a = x as isize + k;
+                        let b = y as isize + j;
+                        if a >= 0
+                            && b >= 0
+                            && a < n as isize
+                            && b < n as isize
+                            && ink[b as usize * n + a as usize]
+                        {
+                            border = true;
+                        }
+                    }
+                }
+            }
+            if ink[i] || border {
+                pixels[4 * i..4 * i + 3].copy_from_slice(if ink[i] {
+                    &s.color
+                } else {
+                    &[15, 18, 21]
+                });
+                pixels[4 * i + 3] = 255;
+            }
+        }
+    }
+    (width, pixels)
+}
+pub fn command(v: &Value, event_loop: &ActiveEventLoop, window: &Window) {
+    let Some(s) = settings(v) else {
+        return;
+    };
+    STATE.with_borrow_mut(|state| state.settings = s);
+    refresh(event_loop, window);
+    crate::launcher_host::emit(
+        serde_json::json!({"type":"applied","command":"crosshair","value":true}),
+    );
+}
+pub fn refresh(event_loop: &ActiveEventLoop, window: &Window) {
+    STATE.with_borrow_mut(|state| {
+        state.generation += 1;
+        for game in state.game.values_mut() {
+            game.prepared.clear();
+        }
+        state.applied = None;
+        state.cursor = None;
+        state.hand = None;
+        state.pixels.clear();
+        state.width = 0;
+        state.hotspot = (0, 0);
+        if state.settings.style == "default" {
+            return;
+        }
+        let (width, mut pixels, hotspot) = if state.settings.style == "original" {
+            let Some(image) = original_pointer(32512) else {
+                return;
+            };
+            image
+        } else {
+            let (w, p) = raster(&state.settings, window.scale_factor());
+            (w, p, (w / 2, w / 2))
+        };
+        if state.settings.style == "original" {
+            recolor(&mut pixels, &state.settings.color);
+        }
+        if state.settings.style == "original" {
+            if let Some((w, mut p, h)) = original_pointer(32649) {
+                recolor(&mut p, &state.settings.color);
+                if let Ok(source) = CustomCursor::from_rgba(p, w, w, h.0, h.1) {
+                    state.hand = Some(event_loop.create_custom_cursor(source));
+                }
+            }
+        }
+        if let Ok(source) =
+            CustomCursor::from_rgba(pixels.clone(), width, width, hotspot.0, hotspot.1)
+        {
+            state.cursor = Some(event_loop.create_custom_cursor(source));
+            state.pixels = pixels;
+            state.width = width;
+            state.hotspot = hotspot;
+        }
+    });
+}
+fn recolor(pixels: &mut [u8], color: &[u8; 3]) {
+    for p in pixels.chunks_exact_mut(4) {
+        let light = *p[..3].iter().max().expect("RGB") as f64 / 255.0;
+        if light > 0.2 {
+            for (index, color) in color.iter().enumerate() {
+                p[index] = (*color as f64 * light).round() as u8;
+            }
+        }
+    }
+}
+pub fn apply(window: &Window, icon: egui::CursorIcon) {
+    STATE.with_borrow_mut(|state| {
+        let eligible = matches!(
+            icon,
+            egui::CursorIcon::Default
+                | egui::CursorIcon::PointingHand
+                | egui::CursorIcon::Grab
+                | egui::CursorIcon::Crosshair
+        );
+        let frame = state
+            .selected_game
+            .as_ref()
+            .and_then(|name| state.game.get(name))
+            .map(|g| {
+                if g.prepared.len() > 1 && g.image.frame_rate > 0.0 {
+                    (g.started.elapsed().as_secs_f64() * g.image.frame_rate) as usize
+                        % g.prepared.len()
+                } else {
+                    0
+                }
+            })
+            .unwrap_or(0);
+        if state.game_frame != frame {
+            state.game_frame = frame;
+            state.applied = None;
+        }
+        let game = if ["default", "original"].contains(&state.settings.style.as_str()) {
+            state
+                .selected_game
+                .as_ref()
+                .and_then(|name| state.game.get(name))
+                .and_then(|g| g.prepared.get(frame))
+        } else {
+            None
+        };
+        let custom = eligible && (game.is_some() || state.cursor.is_some());
+        if state.applied == Some((icon, custom)) {
+            return;
+        }
+        state.applied = Some((icon, custom));
+        if crate::launcher_host::fixture() {
+            return;
+        }
+        window.set_cursor_visible(icon != egui::CursorIcon::None);
+        if custom {
+            window.set_cursor(
+                if game.is_some() {
+                    game
+                } else if icon == egui::CursorIcon::PointingHand {
+                    state.hand.as_ref().or(state.cursor.as_ref())
+                } else {
+                    state.cursor.as_ref()
+                }
+                .expect("cached cursor")
+                .clone(),
+            );
+        } else {
+            window.set_cursor(match icon {
+                egui::CursorIcon::PointingHand => CursorIcon::Pointer,
+                egui::CursorIcon::Grab => CursorIcon::Grab,
+                egui::CursorIcon::Text => CursorIcon::Text,
+                _ => CursorIcon::Default,
+            });
+        }
+    });
+}
+
+struct GameCursor {
+    image: ruffle_core::backend::ui::CustomMouseCursor,
+    prepared: Vec<CustomCursor>,
+    started: std::time::Instant,
+}
+pub fn register_game(name: String, image: ruffle_core::backend::ui::CustomMouseCursor) -> bool {
+    STATE.with_borrow_mut(|s| {
+        if s.game.len() >= 64 && !s.game.contains_key(&name) {
+            return false;
+        }
+        s.game.insert(
+            name,
+            GameCursor {
+                image,
+                prepared: Vec::new(),
+                started: std::time::Instant::now(),
+            },
+        );
+        s.applied = None;
+        true
+    })
+}
+pub fn select_game(name: Option<String>) {
+    STATE.with_borrow_mut(|s| {
+        if s.selected_game != name {
+            if let Some(cursor) = name.as_ref().and_then(|name| s.game.get_mut(name)) {
+                cursor.started = std::time::Instant::now();
+            }
+            s.selected_game = name;
+            s.game_frame = 0;
+            s.applied = None;
+        }
+    });
+}
+pub fn unregister_game(name: &str) {
+    STATE.with_borrow_mut(|s| {
+        s.game.remove(name);
+        if s.selected_game.as_deref() == Some(name) {
+            s.selected_game = None;
+        }
+        s.applied = None;
+    });
+}
+pub fn prepare_game(event_loop: &ActiveEventLoop) {
+    STATE.with_borrow_mut(|s| {
+        let color = if s.settings.style == "original" {
+            Some(s.settings.color)
+        } else {
+            None
+        };
+        for game in s.game.values_mut().filter(|g| g.prepared.is_empty()) {
+            for raw in &game.image.frames {
+                let mut rgba = raw.clone();
+                if let Some(color) = color {
+                    recolor(&mut rgba, &color);
+                }
+                if let Ok(source) = CustomCursor::from_rgba(
+                    rgba,
+                    game.image.width,
+                    game.image.height,
+                    game.image.hotspot.0,
+                    game.image.hotspot.1,
+                ) {
+                    game.prepared.push(event_loop.create_custom_cursor(source));
+                }
+            }
+        }
+    });
+}
+pub fn game_snapshot() -> Value {
+    STATE.with_borrow(|s| {
+        let selected = s.selected_game.as_ref().and_then(|n|s.game.get(n));
+        serde_json::json!({"registered":s.game.len(),"selected":s.selected_game,"frame":s.game_frame,"ready":selected.is_some_and(|g|!g.prepared.is_empty()),"width":selected.map(|g|g.image.width),"height":selected.map(|g|g.image.height),"hotspot":selected.map(|g|g.image.hotspot),"rgba":selected.and_then(|g|g.image.frames.first()),"dryRun":crate::launcher_host::fixture()})
+    })
+}
+pub fn snapshot() -> Value {
+    STATE.with_borrow(|s|serde_json::json!({"style":s.settings.style,"generation":s.generation,"width":s.width,"hotspot":[s.hotspot.0,s.hotspot.1],"rgba":s.pixels,"custom":s.cursor.is_some(),"applied":s.applied.map(|(_,v)|v),"dryRun":crate::launcher_host::fixture()}))
+}
+
+#[cfg(not(windows))]
+fn original_pointer(kind: usize) -> Option<(u16, Vec<u8>, (u16, u16))> {
+    None
+}
+#[cfg(windows)]
+fn original_pointer(kind: usize) -> Option<(u16, Vec<u8>, (u16, u16))> {
+    use std::{ffi::c_void, ptr::null_mut};
+    type H = *mut c_void;
+    #[repr(C)]
+    struct Icon {
+        icon: i32,
+        x: u32,
+        y: u32,
+        mask: H,
+        color: H,
+    }
+    #[repr(C)]
+    struct Bitmap {
+        kind: i32,
+        width: i32,
+        height: i32,
+        row: i32,
+        planes: u16,
+        bits: u16,
+        pixels: H,
+    }
+    #[repr(C)]
+    struct Info {
+        size: u32,
+        width: i32,
+        height: i32,
+        planes: u16,
+        bits: u16,
+        compression: u32,
+        bytes: u32,
+        x: i32,
+        y: i32,
+        used: u32,
+        important: u32,
+    }
+    #[link(name = "user32")]
+    unsafe extern "system" {
+        fn LoadCursorW(instance: H, name: *const u16) -> H;
+        fn GetIconInfo(cursor: H, icon: *mut Icon) -> i32;
+        fn DrawIconEx(
+            dc: H,
+            x: i32,
+            y: i32,
+            icon: H,
+            w: i32,
+            h: i32,
+            step: u32,
+            brush: H,
+            flags: u32,
+        ) -> i32;
+    }
+    #[link(name = "gdi32")]
+    unsafe extern "system" {
+        fn GetObjectW(object: H, size: i32, data: H) -> i32;
+        fn DeleteObject(object: H) -> i32;
+        fn CreateCompatibleDC(dc: H) -> H;
+        fn DeleteDC(dc: H) -> i32;
+        fn SelectObject(dc: H, object: H) -> H;
+        fn CreateDIBSection(
+            dc: H,
+            info: *const Info,
+            usage: u32,
+            pixels: *mut H,
+            section: H,
+            offset: u32,
+        ) -> H;
+        fn GetPixel(dc: H, x: i32, y: i32) -> u32;
+    }
+    unsafe {
+        let cursor = LoadCursorW(null_mut(), kind as *const u16);
+        let mut icon: Icon = std::mem::zeroed();
+        if cursor.is_null() || GetIconInfo(cursor, &mut icon) == 0 {
+            return None;
+        }
+        let result = (|| {
+            let mut bm: Bitmap = std::mem::zeroed();
+            let object = if icon.color.is_null() {
+                icon.mask
+            } else {
+                icon.color
+            };
+            if GetObjectW(
+                object,
+                std::mem::size_of::<Bitmap>() as i32,
+                (&mut bm as *mut Bitmap).cast(),
+            ) == 0
+            {
+                return None;
+            }
+            let h = if icon.color.is_null() {
+                bm.height / 2
+            } else {
+                bm.height
+            };
+            let size = bm.width.max(h) | 1;
+            if size < 1 || size > 145 {
+                return None;
+            }
+            let info = Info {
+                size: 40,
+                width: size,
+                height: -size,
+                planes: 1,
+                bits: 32,
+                compression: 0,
+                bytes: 0,
+                x: 0,
+                y: 0,
+                used: 0,
+                important: 0,
+            };
+            let mut raw = null_mut();
+            let color = CreateDIBSection(null_mut(), &info, 0, &mut raw, null_mut(), 0);
+            let dc = CreateCompatibleDC(null_mut());
+            if color.is_null() || dc.is_null() || raw.is_null() {
+                if !color.is_null() {
+                    DeleteObject(color);
+                }
+                if !dc.is_null() {
+                    DeleteDC(dc);
+                }
+                return None;
+            }
+            let old = SelectObject(dc, color);
+            let bytes =
+                std::slice::from_raw_parts_mut(raw.cast::<u8>(), size as usize * size as usize * 4);
+            bytes.fill(0);
+            if DrawIconEx(dc, 0, 0, cursor, bm.width, h, 0, null_mut(), 3) == 0 {
+                SelectObject(dc, old);
+                DeleteDC(dc);
+                DeleteObject(color);
+                return None;
+            }
+            let alpha = bytes.chunks_exact(4).any(|p| p[3] > 0);
+            let mask_dc = CreateCompatibleDC(null_mut());
+            if mask_dc.is_null() {
+                SelectObject(dc, old);
+                DeleteDC(dc);
+                DeleteObject(color);
+                return None;
+            }
+            let old_mask = SelectObject(mask_dc, icon.mask);
+            let mut rgba = vec![0; bytes.len()];
+            for y in 0..size {
+                for x in 0..size {
+                    let i = (y * size + x) as usize * 4;
+                    rgba[i..i + 3].copy_from_slice(&[bytes[i + 2], bytes[i + 1], bytes[i]]);
+                    rgba[i + 3] = if alpha {
+                        bytes[i + 3]
+                    } else if x < bm.width
+                        && y < h
+                        && (GetPixel(mask_dc, x, y) == 0 || bytes[i..i + 3].iter().any(|v| *v > 0))
+                    {
+                        255
+                    } else {
+                        0
+                    };
+                }
+            }
+            SelectObject(mask_dc, old_mask);
+            DeleteDC(mask_dc);
+            SelectObject(dc, old);
+            DeleteDC(dc);
+            DeleteObject(color);
+            Some((
+                size as u16,
+                rgba,
+                (
+                    icon.x.min(size as u32 - 1) as u16,
+                    icon.y.min(size as u32 - 1) as u16,
+                ),
+            ))
+        })();
+        if !icon.color.is_null() {
+            DeleteObject(icon.color);
+        }
+        if !icon.mask.is_null() {
+            DeleteObject(icon.mask);
+        }
+        result
+    }
+}
