diff --git a/core/src/presentation_clock.rs b/core/src/presentation_clock.rs
new file mode 100644
index 0000000000000000000000000000000000000000..88789580daf869dfd8804a27fc55179be7438fb4
--- /dev/null
+++ b/core/src/presentation_clock.rs
@@ -0,0 +1,44 @@
+//! Keep automatic timeline timing separate from the presentation cadence.
+use std::time::Duration;
+
+pub struct PresentationClock {
+    pub requested_rate: f64,
+    pub advance: bool,
+    next_frame: Duration,
+}
+impl PresentationClock {
+    pub fn new() -> Self {
+        Self {
+            requested_rate: 60.0,
+            advance: true,
+            next_frame: Duration::ZERO,
+        }
+    }
+    pub fn private_fixture() -> Option<Self> {
+        (std::env::var_os("BLITZ_FPS_PRESERVE_TIMELINES").is_some()
+            && std::env::var("BLITZ_PRIVATE_DESKTOP")
+                .is_ok_and(|name| name.starts_with("BlitzTest-")))
+        .then_some(Self {
+            requested_rate: 60.0,
+            advance: true,
+            next_frame: Duration::ZERO,
+        })
+    }
+    pub fn tick(&mut self, elapsed: Duration) {
+        // The existing Flash host executes automatic timelines at no more than
+        // 60/s even when this client requests 100. Preserve that observed speed.
+        let rate = if self.requested_rate.is_finite() {
+            self.requested_rate.clamp(0.01, 60.0)
+        } else {
+            60.0
+        };
+        let period = Duration::from_secs_f64(1.0 / rate);
+        self.advance = elapsed >= self.next_frame;
+        if self.advance {
+            self.next_frame += period;
+            if elapsed.saturating_sub(self.next_frame) > period * 4 {
+                self.next_frame = elapsed + period;
+            }
+        }
+    }
+}
