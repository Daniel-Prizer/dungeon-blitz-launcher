+    #[test]
+    fn bounded_settings_and_raster() {
+        for style in ["cross", "dot", "ring"] {
+            let s = settings(
+                &serde_json::json!({"style":style,"color":"#8cff65","size":48,"outline":true}),
+            )
+            .expect("settings");
+            for dpi in [0.5, 1.0, 1.5, 2.0, 3.0] {
+                let (w, p) = raster(&s, dpi);
+                assert!(w <= 145);
+                assert_eq!(p.len(), w as usize * w as usize * 4);
+                assert!(p.chunks_exact(4).any(|v| v[3] == 255));
+            }
+        }
+        assert!(!valid(&serde_json::json!({"style":"ring"})));
+        assert!(!valid(
+            &serde_json::json!({"style":"ring","color":"#fffffg","size":4000,"outline":true})
+        ));
+    }
+}
