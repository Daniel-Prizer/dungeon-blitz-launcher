+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{LazyLock, Mutex};
+use std::time::Instant;
+
+pub static SOURCE: AtomicU64 = AtomicU64::new(0);
+static PRECISE: LazyLock<bool> = LazyLock::new(|| std::env::var_os("BLITZ_FPS_PRECISE").is_some());
+static DIRECT_LOOP: LazyLock<bool> =
+    LazyLock::new(|| std::env::var_os("BLITZ_FPS_DIRECT_LOOP").is_some());
+pub fn direct_loop() -> bool {
+    *DIRECT_LOOP || crate::launcher_host::production()
+}
+pub fn precise() -> bool {
+    *PRECISE || crate::launcher_host::production()
+}
+pub struct OwnTimer(bool);
+#[cfg(windows)]
+#[link(name = "winmm")]
+unsafe extern "system" {
+    fn timeBeginPeriod(period: u32) -> u32;
+    fn timeEndPeriod(period: u32) -> u32;
+}
+#[cfg(windows)]
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn GetCurrentProcess() -> *mut std::ffi::c_void;
+    fn SetProcessInformation(
+        process: *mut std::ffi::c_void,
+        class: u32,
+        value: *const std::ffi::c_void,
+        length: u32,
+    ) -> i32;
+}
+pub fn init_timer() -> OwnTimer {
+    if !precise()
+        || (!crate::launcher_host::production()
+            && !std::env::var("BLITZ_PRIVATE_DESKTOP")
+                .is_ok_and(|name| name.starts_with("BlitzTest-")))
+    {
+        return OwnTimer(false);
+    }
+    #[cfg(windows)]
+    unsafe {
+        let state = [1u32, 4u32, 0u32];
+        let policy = SetProcessInformation(GetCurrentProcess(), 4, state.as_ptr().cast(), 12);
+        let timer = timeBeginPeriod(1) == 0;
+        tracing::info!(
+            "BLITZ_TIMER ownProcess=true policy={} resolution={}",
+            policy,
+            timer
+        );
+        return OwnTimer(timer);
+    }
+    #[cfg(not(windows))]
+    OwnTimer(false)
+}
+impl Drop for OwnTimer {
+    fn drop(&mut self) {
+        #[cfg(windows)]
+        if self.0 {
+            unsafe {
+                timeEndPeriod(1);
+            }
+        }
+    }
+}
+static CLOCK: LazyLock<Instant> = LazyLock::new(Instant::now);
+static COUNTS: Mutex<(u64, u64, u64, u128, u128)> = Mutex::new((0, 0, 0, 0, 0));
+static CAPTURED: AtomicU64 = AtomicU64::new(0);
+static CAPTURE_REQUEST: AtomicU64 = AtomicU64::new(0);
+pub fn request_capture(id: u64) {
+    CAPTURE_REQUEST.store(id, Ordering::Release);
+}
+static TIMING: LazyLock<Mutex<std::collections::BTreeMap<&'static str, (u64, u128, u128, u128)>>> =
+    LazyLock::new(|| Mutex::new(std::collections::BTreeMap::new()));
+
+pub fn timing(stage: &'static str, started: Instant) {
+    if SOURCE.load(Ordering::Relaxed) == 0 {
+        return;
+    }
+    let cost = started.elapsed().as_micros();
+    let now = CLOCK.elapsed().as_micros();
+    let mut all = TIMING.lock().expect("owned timings");
+    let counts = all.entry(stage).or_insert((0, 0, 0, now));
+    counts.0 += 1;
+    counts.1 += cost;
+    counts.2 = counts.2.max(cost);
+    if now - counts.3 >= 1_000_000 {
+        tracing::info!(
+            "BLITZ_COST stage={} calls={} meanUs={} maxUs={}",
+            stage,
+            counts.0,
+            counts.1 / counts.0 as u128,
+            counts.2
+        );
+        *counts = (0, 0, 0, now);
+    }
+}
+
+pub struct ProbeLog;
+impl ruffle_core::backend::log::LogBackend for ProbeLog {
+    fn avm_trace(&self, message: &str) {
+        if crate::launcher_host::production() && !crate::launcher_host::fixture() {
+            return;
+        }
+        if let Some(value) = message.strip_prefix("BLITZ_SOURCE ") {
+            if let Ok(value) = value.parse::<u64>() {
+                SOURCE.store(value, Ordering::Release);
+            }
+        } else {
+            tracing::info!(target:"avm_trace","{}",message);
+        }
+    }
+    fn avm_warning(&self, message: &str) {
+        if crate::launcher_host::production() && !crate::launcher_host::fixture() {
+            return;
+        }
+        tracing::info!(target:"avm_warning","{}",message);
+    }
+}
+
+pub fn complete(source: u64) {
+    if crate::launcher_host::production() {
+        native_complete();
+    }
+    if source == 0 {
+        return;
+    }
+    let phase = source >> 32;
+    let now = CLOCK.elapsed().as_micros();
+    let mut counts = COUNTS.lock().expect("owned probe counter");
+    if counts.0 != phase {
+        *counts = (phase, 0, 0, now, now);
+    }
+    if source == counts.1 {
+        return;
+    }
+    counts.1 = source;
+    counts.2 += 1;
+    if now - counts.4 >= 1_000_000 {
+        let elapsed = now - counts.3;
+        if SOURCE.load(Ordering::Acquire) >> 32 == phase {
+            tracing::info!(
+                "BLITZ_GPU_PROOF {{\"phase\":{},\"completed\":{},\"elapsedUs\":{},\"fps\":{},\"lastRevision\":{}}}",
+                phase,
+                counts.2,
+                elapsed,
+                (counts.2 - 1) as f64 * 1_000_000.0 / elapsed as f64,
+                source & 0xffff_ffff
+            );
+        } else {
+            tracing::info!(
+                "BLITZ_GPU_DRAIN {{\"phase\":{},\"completed\":{},\"elapsedUs\":{},\"lastRevision\":{}}}",
+                phase,
+                counts.2,
+                elapsed,
+                source & 0xffff_ffff
+            );
+        }
+        counts.4 = now;
+    }
+}
+
+static NATIVE_CAP: AtomicU64 = AtomicU64::new(120);
+#[derive(Default)]
+struct NativeCounts {
+    count: u64,
+    start: Option<Instant>,
+    samples: std::collections::VecDeque<(u64, f64)>,
+    serial: u64,
+    last: Option<(u64, f64, f64, f64)>,
+}
+static NATIVE_COMPLETIONS: LazyLock<Mutex<NativeCounts>> =
+    LazyLock::new(|| Mutex::new(NativeCounts::default()));
+pub fn set_cap(cap: u32) {
+    NATIVE_CAP.store(cap as u64, Ordering::Release);
+    *NATIVE_COMPLETIONS.lock().unwrap() = NativeCounts::default();
+}
+pub fn set_visible(_visible: bool) {
+    let mut s = NATIVE_COMPLETIONS.lock().unwrap();
+    s.start = None;
+    s.count = 0;
+}
+pub fn render_sample() -> Option<(u64, f64, f64, f64)> {
+    NATIVE_COMPLETIONS.lock().unwrap().last
+}
+fn native_complete() {
+    let mut s = NATIVE_COMPLETIONS.lock().unwrap();
+    let now = Instant::now();
+    let since = *s.start.get_or_insert(now);
+    s.count += 1;
+    let elapsed = now.duration_since(since).as_secs_f64();
+    if elapsed < 1.0 {
+        return;
+    }
+    let frames = s.count - 1;
+    let fps = frames as f64 / elapsed;
+    s.samples.push_back((frames, elapsed));
+    while s.samples.len() > 30 {
+        s.samples.pop_front();
+    }
+    let (frames, seconds) = s
+        .samples
+        .iter()
+        .fold((0, 0.0), |(n, t), (a, b)| (n + a, t + b));
+    let average = frames as f64 / seconds;
+    let low = s
+        .samples
+        .iter()
+        .map(|(n, t)| *n as f64 / t)
+        .fold(f64::INFINITY, f64::min);
+    let high = s
+        .samples
+        .iter()
+        .map(|(n, t)| *n as f64 / t)
+        .fold(0.0, f64::max);
+    s.serial += 1;
+    s.last = Some((s.serial, fps, low, high));
+    crate::launcher_host::emit(
+        serde_json::json!({"type":"native-status","value":{"phase":"running","cap":NATIVE_CAP.load(Ordering::Acquire),"renderFPS":fps,"averageFPS":average,"lowFPS":low,"highFPS":high,"sampleSeconds":seconds}}),
+    );
+    s.count = 1;
+    s.start = Some(now);
+}
+
+pub fn capture(
+    source: u64,
+    texture: &wgpu::Texture,
+    descriptors: &ruffle_render_wgpu::descriptors::Descriptors,
+) {
+    let request = CAPTURE_REQUEST.swap(0, Ordering::AcqRel);
+    let phase = if request > 0 { request } else { source >> 32 };
+    if request == 0
+        && (phase == 0 || source & 0xffff_ffff < 100 || CAPTURED.load(Ordering::Relaxed) == phase)
+    {
+        return;
+    }
+    let Ok(directory) = std::env::var("BLITZ_FPS_PROOF_DIR") else {
+        return;
+    };
+    if !std::env::var("BLITZ_PRIVATE_DESKTOP").is_ok_and(|name| name.starts_with("BlitzTest-")) {
+        return;
+    }
+    if request == 0 {
+        CAPTURED.store(phase, Ordering::Relaxed);
+    }
+    let size = texture.size();
+    let dims = ruffle_render_wgpu::utils::BufferDimensions::new(
+        size.width as usize,
+        size.height as usize,
+        texture.format(),
+    );
+    let buffer = descriptors.device.create_buffer(&wgpu::BufferDescriptor {
+        label: Some("Owned FPS proof"),
+        size: dims.size(),
+        usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+        mapped_at_creation: false,
+    });
+    let mut encoder = descriptors
+        .device
+        .create_command_encoder(&Default::default());
+    encoder.copy_texture_to_buffer(
+        texture.as_image_copy(),
+        wgpu::TexelCopyBufferInfo {
+            buffer: &buffer,
+            layout: wgpu::TexelCopyBufferLayout {
+                offset: 0,
+                bytes_per_row: Some(dims.padded_bytes_per_row),
+                rows_per_image: None,
+            },
+        },
+        size,
+    );
+    let index = descriptors.queue.submit([encoder.finish()]);
+    let (send, receive) = std::sync::mpsc::channel();
+    buffer
+        .slice(..)
+        .map_async(wgpu::MapMode::Read, move |result| {
+            let _ = send.send(result);
+        });
+    if descriptors
+        .device
+        .poll(wgpu::PollType::Wait {
+            submission_index: Some(index),
+            timeout: Some(std::time::Duration::from_secs(2)),
+        })
+        .is_err()
+    {
+        tracing::error!("BLITZ_GPU_CAPTURE timeout");
+        return;
+    }
+    if !receive
+        .recv_timeout(std::time::Duration::from_secs(2))
+        .is_ok_and(|result| result.is_ok())
+    {
+        return;
+    }
+    let Ok(mapped) = buffer.slice(..).get_mapped_range() else {
+        return;
+    };
+    let bytes: Vec<u8> = mapped
+        .chunks(dims.padded_bytes_per_row as usize)
+        .flat_map(|row| row[..dims.unpadded_bytes_per_row].iter().copied())
+        .collect();
+    if let Some(picture) = image::RgbaImage::from_raw(size.width, size.height, bytes) {
+        let filename = if request > 0 {
+            format!("scene-{request}.png")
+        } else {
+            format!("gpu-phase-{phase}.png")
+        };
+        let output = std::path::Path::new(&directory).join(filename);
+        if picture.save(output).is_ok() {
+            if request > 0 {
+                tracing::info!(
+                    "BLITZ_SCENE_CAPTURE id={} width={} height={}",
+                    request,
+                    size.width,
+                    size.height
+                );
+            } else {
+                tracing::info!(
+                    "BLITZ_GPU_CAPTURE {{\"phase\":{},\"source\":{},\"width\":{},\"height\":{}}}",
+                    phase,
+                    source & 0xffff_ffff,
+                    size.width,
+                    size.height
+                );
+            }
+        }
+    }
+    drop(mapped);
+    buffer.unmap();
+}
