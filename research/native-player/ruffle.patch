new file mode 100644
index 0000000000000000000000000000000000000000..d7aec6f25a21dfc1a63430fa1f4395d0112def91
--- /dev/null
+++ b/frontend-utils/src/backends/native_resource.rs
@@ -0,0 +1,91 @@
+use std::sync::LazyLock;
+use url::Url;
+
+struct Policy {
+    origin: String,
+    broker: Url,
+    token: String,
+}
+static POLICY: LazyLock<Result<Option<Policy>, &'static str>> = LazyLock::new(|| {
+    let Ok(value) = std::env::var("BLITZ_NATIVE_RESOURCE_BROKER") else {
+        return Ok(None);
+    };
+    let broker = Url::parse(&value).map_err(|_| "Invalid resource broker")?;
+    if broker.scheme() != "http"
+        || broker.host_str() != Some("127.0.0.1")
+        || broker.port().is_none()
+        || broker.path() != "/"
+        || broker.query().is_some()
+        || broker.fragment().is_some()
+        || !broker.username().is_empty()
+        || broker.password().is_some()
+    {
+        return Err("Invalid resource broker");
+    }
+    let origin =
+        std::env::var("BLITZ_NATIVE_RESOURCE_ORIGIN").map_err(|_| "Missing resource origin")?;
+    if ![
+        "https://dungeonblitzr.theminesa.studio",
+        "https://dungeonblitz.theminesa.studio",
+    ]
+    .contains(&origin.as_str())
+    {
+        return Err("Invalid resource origin");
+    }
+    let token =
+        std::env::var("BLITZ_NATIVE_RESOURCE_TOKEN").map_err(|_| "Missing resource token")?;
+    if token.len() != 64 || !token.bytes().all(|value| value.is_ascii_hexdigit()) {
+        return Err("Invalid resource token");
+    }
+    Ok(Some(Policy {
+        origin,
+        broker,
+        token,
+    }))
+});
+
+pub fn socket_allowed(host: &str, port: u16) -> bool {
+    let Ok(Some(_policy)) = &*POLICY else {
+        return false;
+    };
+    std::env::var("BLITZ_NATIVE_TCP").as_deref() == Ok("1")
+        && port == 8080
+        && host == "dungeonblitzr.theminesa.studio"
+        && std::env::var("BLITZ_NATIVE_TCP_HOST").as_deref() == Ok(host)
+}
+
+pub fn enabled() -> bool {
+    !matches!(&*POLICY, Ok(None))
+}
+
+pub fn rewrite(mut url: Url) -> Result<(Url, Option<String>), &'static str> {
+    let Some(policy) = POLICY.as_ref().map_err(|value| *value)? else {
+        return Ok((url, None));
+    };
+    if !url.username().is_empty() || url.password().is_some() || url.fragment().is_some() {
+        return Err("Resource URL rejected");
+    }
+    let own = policy.broker.origin();
+    if url.origin() != own {
+        let origin = url.origin().ascii_serialization();
+        // The reviewed ResourceManager emits this legacy origin when the
+        // alternative official page is selected. Nothing is fetched over HTTP:
+        // the broker serves only its already-admitted public resource paths.
+        let legacy = [
+            "http://dungeonblitzr.theminesa.studio",
+            "https://dungeonblitzr.theminesa.studio",
+        ]
+        .contains(&origin.as_str());
+        if origin != policy.origin && !legacy {
+            return Err("Resource origin rejected");
+        }
+        let mut target = policy.broker.clone();
+        target.set_path(url.path());
+        target.set_query(url.query());
+        url = target;
+    }
+    if url.origin() != own {
+        return Err("Resource origin rejected");
+    }
+    Ok((url, Some(policy.token.clone())))
+}
