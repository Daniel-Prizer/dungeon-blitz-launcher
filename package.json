{
  "name": "dungeon-blitz-launcher",
  "productName": "Dungeon Blitz Launcher",
  "version": "0.20.0",
  "description": "A dedicated Dungeon Blitz launcher with an isolated original Flash game host.",
  "main": "src/main.cjs",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prepare:game": "node scripts/prepare-legacy.cjs",
    "test": "node --test test/*.test.cjs",
    "test:launcher": "node scripts/launcher-test.cjs",
    "check:modern-web": "node scripts/check-modern-web.cjs",
    "check:modern-enhancements": "node scripts/check-modern-enhancements.cjs",
    "test:native": "node scripts/test-native.cjs",
    "test:input": "node scripts/test-native.cjs --focus",
    "package": "node scripts/package.cjs",
    "test:margins": "node scripts/test-native.cjs --margins",
    "test:window": "node scripts/test-native.cjs --window",
    "test:render": "node scripts/test-native.cjs --render",
    "test:fps": "node scripts/test-native.cjs --fps",
    "test:projector": "node scripts/test-projector.cjs",
    "test:projector:storage": "node scripts/test-projector.cjs --storage",
    "release:sign": "node scripts/sign-release.cjs",
    "test:transition": "node scripts/test-native.cjs --transition",
    "test:camera": "node scripts/test-native.cjs --camera",
    "installer": "node scripts/installer.cjs",
    "test:installer": "node scripts/test-installer.cjs",
    "test:updater": "node scripts/test-updater-electron.cjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "electron": "44.7.0",
    "playwright": "1.64.0"
  }
}
