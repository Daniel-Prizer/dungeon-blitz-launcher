  private function start(e:Event=null):void {stage.scaleMode=StageScaleMode.NO_SCALE;stage.align=StageAlign.TOP_LEFT;graphics.beginFill(0x292d38);graphics.drawRect(0,0,1600,900);graphics.endFill();ExternalInterface.addCallback('BlitzArtworkState',state);loadPrerequisite();}
  private function loadPrerequisite():void {if(prerequisiteIndex==prerequisites.length){loadNext();return;}var loader:Loader=new Loader();loader.contentLoaderInfo.addEventListener(Event.COMPLETE,function(e:Event):void{prerequisiteIndex++;loadPrerequisite();});loader.contentLoaderInfo.addEventListener(IOErrorEvent.IO_ERROR,function(e:IOErrorEvent):void{failure=e.toString();});loader.load(new URLRequest('/assets/'+prerequisites[prerequisiteIndex]),new LoaderContext(false,ApplicationDomain.currentDomain));}
  private function loadNext():void {if(index==entries.length)return;var loader:Loader=new Loader();loader.contentLoaderInfo.addEventListener(Event.COMPLETE,complete);loader.contentLoaderInfo.addEventListener(IOErrorEvent.IO_ERROR,function(e:IOErrorEvent):void{failure=e.toString();});loader.load(new URLRequest('/assets/'+entries[index][0]),new LoaderContext(false,new ApplicationDomain(ApplicationDomain.currentDomain)));}
  private function stopTree(d:DisplayObject):void {if(d is MovieClip)MovieClip(d).stop();var c:DisplayObjectContainer=d as DisplayObjectContainer;if(c)for(var i:int=0;i<c.numChildren;i++)stopTree(c.getChildAt(i));}
