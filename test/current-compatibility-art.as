package {
 import flash.display.*;import flash.events.*;import flash.net.URLRequest;import flash.system.*;import flash.geom.Rectangle;import flash.external.ExternalInterface;import flash.text.TextField;
 public class DungeonBlitz extends Sprite {
  private var entries:Array=[['Gfx_Paladin_1.swf','a_Torso_OmegaLizard'],['Gfx_Rogue_1.swf','a_Belt_GoldLizard'],['LevelsJC.swf','a_Room_JC01'],['LevelsLD.swf','a_Room_LDArena1_01'],['LevelsLI05.swf','a_Room_MtnSlopeUp1'],['LevelsOMM.swf','a_Room_MtnSlopeUp1'],['UI_4.swf','a_ArmoryWindow']];
  private var records:Array=[];private var failure:String='';private var index:int=0;private var prerequisites:Array=['Utilities.swf','LevelsOMM.swf'];private var prerequisiteIndex:int=0;
